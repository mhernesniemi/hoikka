# Deployment target: "node" (default) or "cloudflare"
HOIKKA_TARGET=node

# Local SQLite database file (node target only; Cloudflare uses the D1 binding).
# Defaults to ./data/hoikka.db — uncomment only to override.
# DATABASE_URL="./data/hoikka.db"

# Better Auth
BETTER_AUTH_SECRET=
# Optional — auth derives the URL from the request. Set only to override
# (e.g. an unusual reverse-proxy setup where the request origin is wrong).
# BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional) — auth codes (sign-in, password reset), digital
# delivery, and shipment emails. Without it, OTPs are logged to the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe (optional)
STRIPE_SECRET_KEY="sk_..."
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# Stripe webhook signing secret (whsec_...). Required for payments to be
# fulfilled reliably: the webhook — not the browser returning to the site —
# is what marks an order paid.
STRIPE_WEBHOOK_SECRET="whsec_..."

# First-run admin setup (/admin/setup). Outside development the route is
# disabled unless this is set, and the form must then supply the same value.
ADMIN_SETUP_SECRET=

# Mock payments settle without moving money. They are available in dev
# automatically; set this only for e2e runs against a production build.
# ENABLE_MOCK_PAYMENTS=true

# Public origin used for links generated outside a request (delivery emails,
# outbox jobs). Falls back to the request origin when there is one.
# PUBLIC_STORE_URL="https://store.example.com"

# Cron/housekeeping shared secret for POST /api/tasks/run (required in
# production). The companion cron worker sends it as a bearer token, and asks
# for ?housekeeping=1 once an hour to sweep abandoned drafts and old counters.
TASKS_SECRET=

# NOTE: TASKS_SECRET above is required outside local development — /api/tasks/run
# refuses to run without it rather than falling open.

# Node target only: adapter-node caps request bodies at 512 KB by default,
# which is far below the digital-deliverable upload limit. Raise it to at least
# the cap advertised by /api/assets/upload (200 MB) or those uploads are
# rejected before the handler ever runs. On Cloudflare the equivalent ceiling
# is the plan's request-body limit and is not configurable here.
BODY_SIZE_LIMIT=209715200
