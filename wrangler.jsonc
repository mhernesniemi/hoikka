{
	// Cloudflare Workers config for the "cloudflare" deployment target.
	// Used by `pnpm dev:cf` (local bindings via miniflare), `pnpm deploy:cf`, and
	// `pnpm db:migrate:cf`. create-hoikka-app fills in the real database_id.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hoikka",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoikka-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "hoikka-assets"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			// Guest storefront edge cache version key. create-hoikka-app fills in
			// the real id; without the binding, edge caching is simply disabled.
			"binding": "CACHE_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	// Run the worker near D1 instead of near the visitor: multi-query
	// requests (checkout, admin, logged-in SSR) pay one long client hop
	// instead of a network round trip per query. Cached guest pages are
	// unaffected — they never reach the origin worker logic anyway.
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	}
}
