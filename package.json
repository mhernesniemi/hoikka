{
	"name": "hoikka",
	"version": "0.0.1",
	"author": "Matti Hernesniemi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mhernesniemi/hoikka"
	},
	"homepage": "https://hoikka.dev",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || >=26.12.1"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:cf": "HOIKKA_TARGET=cloudflare vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"deploy:cf": "HOIKKA_TARGET=cloudflare vite build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "vitest --run",
		"db:migrate:cf": "wrangler d1 migrations apply hoikka-db --remote",
		"db:migrate:cf:local": "wrangler d1 migrations apply hoikka-db --local",
		"db:generate": "drizzle-kit generate",
		"db:check": "tsx scripts/db-check.ts",
		"db:studio": "drizzle-kit studio",
		"perf": "node scripts/perf.mjs",
		"seed": "tsx scripts/seed.ts",
		"mcp": "tsx scripts/mcp.ts",
		"oidc:mock": "tsx scripts/oidc-mock.ts"
	},
	"sideEffects": [
		"**/*.css"
	],
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261027.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"oauth2-mock-server": "^9.3.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.154.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@stripe/stripe-js": "^10.2.0",
		"@tanstack/table-core": "^8.21.3",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/extension-placeholder": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.7.14",
		"better-sqlite3": "^13.0.3",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"devalue": "^6.0.3",
		"nanoid": "^6.0.2",
		"resend": "^6.35.0",
		"sharp": "^0.35.5",
		"stripe": "^23.0.1",
		"svelte-sonner": "^1.2.2",
		"svelte-tiptap": "^3.0.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0",
		"xss": "^1.0.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#hoikka/config": "./hoikka.config.ts"
	}
}
