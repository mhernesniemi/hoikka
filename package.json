{
	"name": "hoikka",
	"version": "0.0.1",
	"author": "Matti Hernesniemi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mhernesniemi/hoikka"
	},
	"homepage": "https://hoikka.dev",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:cf": "HOIKKA_TARGET=cloudflare vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"deploy": "HOIKKA_TARGET=cloudflare vite build && wrangler deploy",
		"db:migrate:cf": "wrangler d1 migrations apply hoikka-db --remote",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "vitest --run",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx scripts/seed.ts"
	},
	"sideEffects": [
		"**/*.css"
	],
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260716.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.20.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"wrangler": "^4.111.0"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@stripe/stripe-js": "^8.11.0",
		"@tanstack/table-core": "^8.21.3",
		"@tiptap/core": "^3.28.0",
		"@tiptap/extension-link": "^3.28.0",
		"@tiptap/extension-placeholder": "^3.28.0",
		"@tiptap/pm": "^3.28.0",
		"@tiptap/starter-kit": "^3.28.0",
		"better-auth": "^1.6.23",
		"better-sqlite3": "^12.11.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"devalue": "^5.8.1",
		"nanoid": "^5.1.16",
		"resend": "^6.17.2",
		"sharp": "^0.35.3",
		"stripe": "^20.4.1",
		"svelte-sonner": "^1.1.1",
		"svelte-tiptap": "^3.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.4.2"
	}
}
