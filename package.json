{
	"name": "hoikka",
	"version": "0.0.1",
	"author": "Matti Hernesniemi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mhernesniemi/hoikka"
	},
	"homepage": "https://hoikka.dev",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun drizzle-kit migrate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "bun run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "bun --bun drizzle-kit push",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun --bun drizzle-kit migrate",
		"db:studio": "bun --bun drizzle-kit studio",
		"create:admin": "bun scripts/create-admin.ts",
		"reindex": "bun scripts/reindex-products.ts"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"workflows/**"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-vercel": "^6.3.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "^1.3.6",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.15",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.0.15"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@neondatabase/neon-js": "^0.2.0-beta.1",
		"@neondatabase/serverless": "^0.10.0",
		"@opentelemetry/api": "^1.9.0",
		"@stripe/stripe-js": "^8.7.0",
		"@tanstack/table-core": "^8.21.3",
		"@tiptap/core": "^3.18.0",
		"@tiptap/extension-link": "^3.18.0",
		"@tiptap/extension-placeholder": "^3.18.0",
		"@tiptap/pm": "^3.18.0",
		"@tiptap/starter-kit": "^3.18.0",
		"@vercel/analytics": "^1.6.1",
		"@vercel/blob": "^2.2.0",
		"@vercel/otel": "^2.1.1",
		"@vercel/speed-insights": "^1.3.1",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"nanoid": "^5.1.6",
		"resend": "^6.8.0",
		"stripe": "^20.3.1",
		"svelte-sonner": "^1.0.7",
		"svelte-tiptap": "^3.0.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.2.0",
		"workflow": "^4.1.0-beta.57"
	}
}
